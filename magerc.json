{
  "scripts": [
    {
      "name": "Install Dependencies",
      "command": "composer install"
    },
    {
      "name": "Start Infrastructure",
      "command": "make up"
    },
    {
      "name": "Stop Infrastructure",
      "command": "make down"
    },
    {
      "name": "Start Development Server",
      "command": "make dev"
    },
    {
      "name": "Run Tests",
      "command": "make test"
    },
    {
      "name": "Run Coverage",
      "command": "make coverage"
    },
    {
      "name": "Run SonarQube Scan",
      "command": "make sonar"
    }
  ],
  "replacements": [
    {
      "path": "composer.json",
      "pattern": "auth-service-php"
    }
  ]
}
